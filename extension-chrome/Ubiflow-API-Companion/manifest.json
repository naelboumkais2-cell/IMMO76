{
  "manifest_version": 3,
  "name": "Ubiflow API Companion V1.1.3 (Espion)",
  "version": "1.1.3",
  "description": "Capte silencieusement le token Ubiflow pour alimenter l'API d'automatisation.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.ubiflow.net/*",
    "*://espace-client.ubiflow.net/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ubiflow.net/*", "*://espace-client.ubiflow.net/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["token_stealer.js"],
      "matches": ["*://*.ubiflow.net/*", "*://espace-client.ubiflow.net/*"]
    }
  ]
}
